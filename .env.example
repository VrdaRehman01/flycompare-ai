# FlyCompare AI configuration template.
# Copy to .env (repository root) or backend/.env and fill in values. Never commit real
# secrets: .env files are git-ignored. Settings read by the backend only; nothing here
# is sent to the browser.

# ---------------------------------------------------------------- application
# "development" (or "test") allows local-only behaviour such as the simulated flight
# provider. Any other value is treated as production: secure cookies, live data only.
APP_ENV=development
APP_DEBUG=true

# SQLite needs no setup for local development. Use PostgreSQL in production, e.g.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/flycompare
DATABASE_URL=sqlite:///./flycompare.db

# Browser origins allowed to call the API (the Vite dev server by default).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]

# ------------------------------------------------------------- flight search
# "mock": simulated demo offers, development only (refused when APP_ENV is production).
# "duffel": Duffel API. A duffel_test_ token returns sandbox offers (development only);
# a live token returns real, bookable offers.
# "travelpayouts": recent real fares from the Aviasales Data API (free; email sign-up at
# travelpayouts.com → Programs → join Aviasales → Profile → API token). Results are
# labelled "Recent fare" and link to Aviasales to confirm the price and book.
FLIGHT_PROVIDER=mock
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
DUFFEL_ACCESS_TOKEN=
DUFFEL_API_URL=https://api.duffel.com
DUFFEL_API_VERSION=v2
DUFFEL_TIMEOUT_SECONDS=45

# ------------------------------------------------------ other travel services
# Stays, cars, transfers, tours and flight + hotel have no real inventory provider yet,
# so they are hidden. Set true only to work on them locally; they show simulated options.
DEMO_TRAVEL_SERVICES_ENABLED=false
# auto | duffel | demo. "auto" tries Duffel Stays when FLIGHT_PROVIDER=duffel.
STAYS_PROVIDER=auto

# ------------------------------------------------------------------ accounts
# Keys the hashes of emailed sign-in codes. Required outside development: generate with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Email for sign-in and verification codes (SMTP). Gmail: turn on 2-Step Verification,
# create an App Password at https://myaccount.google.com/apppasswords and use it below
# (your normal Gmail password will not work). Without SMTP_HOST, code sign-in is
# reported as unavailable and password sign-in still works for verified accounts.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=
EMAIL_FROM_NAME=FlyCompare AI
# Code rules: lifetime (minutes), wrong attempts, seconds before resend, codes per email per hour.
LOGIN_CODE_TTL_MINUTES=10
LOGIN_CODE_MAX_ATTEMPTS=5
LOGIN_CODE_RESEND_SECONDS=60
LOGIN_CODES_PER_HOUR=5

# Server-side sessions in an HttpOnly cookie. Cookies are Secure automatically outside
# development; override with SESSION_COOKIE_SECURE=true|false if needed.
SESSION_COOKIE_NAME=fc_session
SESSION_TTL_HOURS=168

# Per-client request limits (requests per minute; in-process, single API instance).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_SEARCH_PER_MINUTE=20

# ------------------------------------------------------- reference data feeds
# Display-only currency conversion: ECB reference rates (Frankfurter), with
# ExchangeRate-API's open endpoint for currencies the ECB does not publish (PKR, AED…).
# Leave the fallback empty to use ECB rates only.
CURRENCY_API_URL=https://api.frankfurter.dev/v1
CURRENCY_FALLBACK_API_URL=https://open.er-api.com/v6/latest

# Destination, sight and vehicle photos from Wikipedia / Wikimedia Commons (free
# licences, credited). Wikimedia refuses (HTTP 403) clients whose User-Agent has no
# contact, so include your site URL or an email address.
DESTINATION_IMAGES_ENABLED=true
WIKIMEDIA_USER_AGENT=FlyCompareAI/0.4 (https://your-site.example; contact@your-site.example)

# Travel guides and the planner use Wikipedia summaries and Open-Meteo weather history.
TRAVEL_EXTERNAL_DATA_ENABLED=true

# Optional fare-estimate model (needs the ML packages in ml/requirements.txt).
FARE_MODEL_PATH=ml/models/fare_log_ridge_model.joblib
