APP_NAME=FlyCompare AI
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api
DATABASE_URL=postgresql+psycopg://flycompare:change-me-local-only@localhost:5432/flycompare
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]
# Reserved; not used. Sign-in uses server-side sessions (see SESSION_* below).
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-use
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Flight provider: "mock" (simulated demo offers) or "duffel".
# The Duffel token stays on the server; it is never sent to the browser.
FLIGHT_PROVIDER=mock
DUFFEL_ACCESS_TOKEN=
DUFFEL_API_URL=https://api.duffel.com
DUFFEL_API_VERSION=v2
DUFFEL_TIMEOUT_SECONDS=45

# Browser sessions (HttpOnly cookie). Cookies are marked Secure automatically
# when APP_ENV is not development/test; override with SESSION_COOKIE_SECURE.
SESSION_COOKIE_NAME=fc_session
SESSION_TTL_HOURS=168

# Per-client request limits (requests per minute, single API process).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_SEARCH_PER_MINUTE=20

# Display-only currency conversion (ECB reference rates via Frankfurter).
CURRENCY_API_URL=https://api.frankfurter.dev/v1

# Optional fare-estimate model (requires the ML packages in ml/requirements.txt).
FARE_MODEL_PATH=ml/models/fare_log_ridge_model.joblib

# Destination photos from Wikipedia / Wikimedia Commons (free licences, credited).
# Required: Wikimedia refuses (HTTP 403) clients without a contact URL or email in the
# User-Agent, and every city then shows the illustration instead of a photo.
DESTINATION_IMAGES_ENABLED=true
WIKIMEDIA_USER_AGENT=FlyCompareAI/0.4 (https://your-site.example; contact@your-site.example)
